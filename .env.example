# PI-SPI BCEAO Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials provided by BCEAO.

# Base URL for the PI-SPI Sandbox API Gateway
PISPI_BASE_URL=https://sandbox.pispi.bceao.int

# OAuth2 Authentication Endpoint URL
PISPI_AUTH_URL=https://sandbox-auth.pispi.bceao.int/oauth/token

# OAuth2 / API Credentials provided in PI-SPI Developer Portal
PISPI_CLIENT_ID=your_client_id_here
PISPI_CLIENT_SECRET=your_client_secret_here
PISPI_API_KEY=your_api_key_here
PISPI_SCOPE=pispi:api

# Participant Identification Code assigned by BCEAO
PISPI_PARTICIPANT_CODE=your_participant_code_here

# Paths to Client TLS Certificate and Private Key (mTLS required for PI-SPI production/sandbox)
PISPI_CERT_PATH=
PISPI_KEY_PATH=
